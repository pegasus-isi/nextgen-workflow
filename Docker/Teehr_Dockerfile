# TEEHR evaluation container for the teehr_evaluation transformation.
#
# CIROH's companion evaluation image bundles TEEHR + Spark + Java +
# /app/teehr_ngen.py, but it is Debian-slim with no curl/wget — and
# PegasusLite must download its worker package inside the container before
# the job script runs. This layer only adds those (plus procps: Spark's
# load-spark-env.sh calls `ps`).
#
# Build:
#   docker build -t kthare10/nextgen-teehr:x86 -f Docker/Teehr_Dockerfile .
#   docker push kthare10/nextgen-teehr:x86
#
# The :x86 base tag is what upstream's runTeehr.sh selects on x86 hosts.

FROM awiciroh/ngiab-teehr:x86

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl wget procps \
    && rm -rf /var/lib/apt/lists/*

# The workflow's vendored analysis modules (forcings_utils via
# ngen_outputs_utils) import matplotlib at module level, and the wrapper's
# pandas fallback needs them when a gage is not in TEEHR's NWM crosswalk.
# All of matplotlib's dependencies are already pinned in the base image.
RUN pip install --no-cache-dir "matplotlib==3.10.9"
